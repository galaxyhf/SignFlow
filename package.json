{
  "name": "signflow",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @signflow/api\" \"npm run dev -w @signflow/web\"",
    "build": "npm run build -w @signflow/api && npm run build -w @signflow/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages tests scripts",
    "test": "vitest run",
    "test:e2e": "node scripts/run-tool.mjs browser-test",
    "db:generate": "npm run db:generate -w @signflow/api",
    "db:migrate": "npm run db:migrate -w @signflow/api",
    "admin:create": "npm run admin:create -w @signflow/api",
    "jobs:run": "npm run jobs:run -w @signflow/api",
    "dev:e2e": "concurrently -k \"node scripts/run-tool.mjs e2e-api\" \"node scripts/run-tool.mjs e2e-web\"",
    "format": "prettier --write apps/api/src apps/api/test apps/web/src packages/shared/src scripts tests *.ts *.mjs *.json docs README.md",
    "test:browser:install": "node scripts/run-tool.mjs browser-install",
    "postinstall": "node scripts/pdf-assets.mjs",
    "admin:promote": "npm run admin:promote -w @signflow/api --"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@eslint/js": "^9.39.0",
    "@nestjs/testing": "^11.2.7",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "js-yaml": "^4.3.2"
  }
}
